{
 "uid": "agent-lab",
 "title": "Agent Lab: AI agent traffic via LiteLLM",
 "tags": [
  "agent-lab",
  "litellm",
  "loki"
 ],
 "description": "Scheduled AI agents (~/agent-lab on .101) calling LiteLLM (.101:4000) -> LM Studio qwen3.8-27b. One JSON log line per agent run, shipped by Alloy to Loki.",
 "timezone": "browser",
 "schemaVersion": 39,
 "editable": false,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Runs",
   "description": "",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": null
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "sum(count_over_time({job=~\"docker|journal\"} |= `\"lab\": \"agent-lab\"` | json | event=\"run\" | persona=~\"$persona\" | host=~\"$host\" [$__range]))",
     "legendFormat": "",
     "queryType": "instant"
    }
   ]
  },
  {
   "id": 2,
